#!/usr/bin/bash
## Usage: build-check <package-folder-name>
## Builds and checks the R package in ./<package-folder-name>.
set -e
PKG=${1:-pkg}
if [ ! -d "$PKG" ]; then
    echo "Error: package folder '$PKG' not found (usage: $0 <package-folder>)" >&2
    exit 1
fi
PKG_NAME=$(awk -F': *' '/^Package:/ {print $2; exit}' "$PKG/DESCRIPTION")
if [ -z "$PKG_NAME" ]; then
    echo "Error: could not read package name from $PKG/DESCRIPTION" >&2
    exit 1
fi
R --version

## Do not let a failing build/check abort the script before the results
## are copied to resultsdir; record the status and exit with it at the end.
STATUS=0
R CMD build --compact-vignettes=both "$PKG" || STATUS=$?
if [ "$STATUS" -eq 0 ]; then
    version=$(awk -F': ' '/^Version:/ {gsub(/\r/,""); print $2; exit}' "$PKG/DESCRIPTION")
    echo "Checking version ${version}"
    R CMD check --as-cran "${PKG_NAME}_${version}.tar.gz" || STATUS=$?
fi

## Copy the check results (00check.log, 00install.out, ...) even when
## build or check failed, so the failure is inspectable in resultsdir.
if [ -d "${PKG_NAME}.Rcheck" ]; then
    cp -r ${PKG_NAME}.Rcheck/* resultsdir/
    ## Results files are created as root inside the container; hand them
    ## back to the invoking host user so they are not left owned by root.
    if [ -n "${HOST_UID:-}" ]; then
        chown -R "${HOST_UID}:${HOST_GID:-0}" resultsdir/
    fi
fi

exit "$STATUS"
