#!/usr/bin/bash
## Test an R package in docker containers with various R versions.
##
## Usage: test-in-docker <package-folder> [-a|-n name] [docker buildx options]
##
## <package-folder>  mandatory: path to the R package source folder
##                   (must contain a DESCRIPTION file)
## -a, --all         build and test all docker images in parallel (default)
## -n, --name NAME   build and test only the image with the given name
##                   (default name: patched)
##
## Remaining arguments are passed to 'docker buildx build'
## (e.g. --no-cache)
set -e  # fail on error

cd $(dirname "$0")
ROOT=$(pwd)

## Known image names.  'devel' and 'patched' share one dockerfile
## (docker/Dockerfile-R) parametrized by the RFLAVOR build-arg;
## every other name maps to its own docker/Dockerfile-<name>.
ALL_NAMES="devel patched patched-openblas-fedora"

dockerfile_for_name() {
    case "$1" in
        devel|patched)  echo docker/Dockerfile-R ;;
        *)              echo "docker/Dockerfile-$1" ;;
    esac
}

rflavor_for_name() {
    case "$1" in
        devel)   echo devel ;;
        patched) echo patched ;;
        *)       echo "" ;;
    esac
}

show_help() {
	echo "Usage: $0 <package-folder> [-a|-n name] [docker buildx options]"
	echo ""
	echo " <package-folder>   path to the R package source folder (mandatory)"
	echo " -a, --all          build and test all docker images in parallel"
	echo " -n, --name NAME    build and test the image with the given name"
	echo ""
	echo "   useful buildx options are:"
	echo "     --no-cache: start building from scratch"
	echo ""
	echo "Available names (default: patched):"
	printf '  %s\n' $ALL_NAMES
	exit "$1"
}

logFName() { echo "build-test-${NAME}.log" ; }

test_in_docker() {
    local TAG DOCKERFILE RFLAVOR BUILDARG logfile
    TAG=${PKG_NAME,,}-$NAME
    DOCKERFILE=$(dockerfile_for_name "$NAME")
    RFLAVOR=$(rflavor_for_name "$NAME")
    BUILDARG=""
    [ -n "$RFLAVOR" ] && BUILDARG="--build-arg RFLAVOR=$RFLAVOR"
    RESULTSDIR=results-${NAME}
    rm -rf results-${NAME} && mkdir ${RESULTSDIR}
    RESULTSDIR_ABS=$(cd "$RESULTSDIR" && pwd)
    logfile=${RESULTSDIR}/$(logFName)
    if [ ! -f "$DOCKERFILE" ]; then
        echo "Error: $DOCKERFILE not found" >&2
        return 1
    fi
    echo "Building ${NAME} (tag ${TAG}), logging to ${logfile} ..."
    echo "build context: pkg=${PKG_ABS}"
    ## Make results dir
    docker buildx build \
        --file="$DOCKERFILE" \
        --build-context=pkg="$PKG_ABS" \
        $BUILDARG \
        --tag="$TAG" \
        --load \
        $DOCKEROPTS \
        "$ROOT" >"$logfile" 2>&1
    echo "Testing $TAG"
    docker run \
	   --mount type=bind,src=${RESULTSDIR_ABS},dst=/resultsdir \
	   -e HOST_UID="$HOST_UID" -e HOST_GID="$HOST_GID" \
	   $TAG ./build-check pkg >>$logfile
    echo ----- Final results of $TAG -----
    cat $logfile | tail -11
}

if [ $# -lt 1 ] || [ "$1" = "-h" ] || [ "$1" = "--help" ]; then
    show_help 1
fi
PKG_LOCATION="$1"; shift

if [ ! -d "$PKG_LOCATION" ]; then
    echo "Error: package folder '$PKG_LOCATION' does not exist" >&2
    show_help 1
fi
if [ ! -f "$PKG_LOCATION/DESCRIPTION" ]; then
    echo "Error: no DESCRIPTION in '$PKG_LOCATION'; is it an R package folder?" >&2
    show_help 1
fi
PKG_ABS=$(cd "$PKG_LOCATION" && pwd)
PKG_PATH=$(basename "$PKG_ABS")
PKG_NAME=$(awk '/^Package:/ { print $2; exit }' ${PKG_LOCATION}/DESCRIPTION)
echo "Package: ${PKG_NAME}"
## Passed into the container so build-check can chown the results
## (created as root) back to the invoking host user.
HOST_UID=$(id -u)
HOST_GID=$(id -g)
DOCKEROPTS=""
NAME="patched"

case "$1" in
    --all|-a)
	shift
	echo "Running check on all Docker containers with package ${PKG_PATH}"
	for NAME in $ALL_NAMES; do
	    test_in_docker &
	done
	wait
	exit 0 ;;
    --name|-n)
	if [ $# -lt 2 ] || [ -z "${2:-}" ] || [ "${2:0:1}" = "-" ]; then
	    echo "Error: -n requires a name" >&2
	    show_help 1
	fi
	NAME="$2"; shift 2
	DOCKEROPTS="$*"
	;;
    *)
	DOCKEROPTS="$*"
	;;
esac

test_in_docker

## to inspect logs: run interactively
## > docker run -it maxlik-${NAME} /bin/bash
